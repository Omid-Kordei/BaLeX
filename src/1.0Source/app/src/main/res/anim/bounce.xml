<set xmlns:android="http://schemas.android.com/apk/res/android">
    <scale
        android:fromXScale="1.0"
        android:toXScale="0.82"
        android:fromYScale="1.0"
        android:toYScale="0.82"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="90"
        android:interpolator="@android:anim/accelerate_interpolator"/>
    <scale
        android:fromXScale="0.82"
        android:toXScale="1.12"
        android:fromYScale="0.82"
        android:toYScale="1.12"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="90"
        android:duration="100"
        android:interpolator="@android:anim/decelerate_interpolator"/>
    <scale
        android:fromXScale="1.12"
        android:toXScale="1.0"
        android:fromYScale="1.12"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="190"
        android:duration="80"
        android:interpolator="@android:anim/decelerate_interpolator"/>
</set>
