<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="right"
    android:paddingLeft="60dp"
    android:paddingRight="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble_received"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/txtSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text=""
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#0088CC"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/quoteBoxReceived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#12000000"
            android:layout_marginBottom="4dp"
            android:paddingLeft="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingRight="6dp"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="#00C853"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="6dp">

                <TextView
                    android:id="@+id/txtQuoteNameReceived"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="کاربر"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#00C853"/>

                <TextView
                    android:id="@+id/txtQuoteTextReceived"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="11sp"
                    android:textColor="#666666"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="200dp"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/txtMsgReceived"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="متن پیام دریافتی"
            android:textSize="14sp"
            android:textColor="#1A1A1A"
            android:maxWidth="220dp"/>

        <TextView
            android:id="@+id/txtTimeReceived"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginTop="2dp"
            android:text="12:30"
            android:textSize="10sp"
            android:textColor="#AAAAAA"/>

    </LinearLayout>

</LinearLayout>