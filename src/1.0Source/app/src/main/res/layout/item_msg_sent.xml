<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="left"
    android:paddingLeft="12dp"
    android:paddingRight="60dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble_sent"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/quoteBoxSent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#22FFFFFF"
            android:layout_marginBottom="4dp"
            android:paddingLeft="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingRight="6dp"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="#FFFFFF"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="6dp">

                <TextView
                    android:id="@+id/txtQuoteNameSent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="کاربر"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/txtQuoteTextSent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="11sp"
                    android:textColor="#DDFFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="200dp"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/txtMsgSent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="متن پیام ارسالی"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:maxWidth="220dp"/>

        <TextView
            android:id="@+id/txtTimeSent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginTop="2dp"
            android:text="12:30 ✓"
            android:textSize="10sp"
            android:textColor="#CCFFFFFF"/>

    </LinearLayout>

</LinearLayout>