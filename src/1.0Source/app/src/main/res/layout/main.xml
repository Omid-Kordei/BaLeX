<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_login"
	android:fillViewport="true"
	android:scrollbars="none">
	<LinearLayout
		android:id="@+id/linear5"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingLeft="32dp"
		android:paddingTop="72dp"
		android:paddingRight="32dp"
		android:paddingBottom="48dp"
		android:gravity="center_horizontal"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear6"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">
			<ImageView
				android:id="@+id/imageview2"
				android:layout_width="54dp"
				android:layout_height="54dp"
				android:src="@drawable/ic_balex"
				android:scaleType="center" />
			<LinearLayout
				android:id="@+id/linear7"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="14dp"
				android:orientation="vertical">
				<TextView
					android:id="@+id/textview6"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="BaLeX"
					android:textSize="32sp"
					android:textStyle="bold"
					android:textColor="#00922C" />
				<TextView
					android:id="@+id/textview7"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Bot Manager"
					android:textSize="13sp"
					android:textColor="#007020" />
			</LinearLayout>
		</LinearLayout>
		<TextView
			android:id="@+id/textview8"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:layout_marginBottom="48dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="مدیریت ربات‌های بله، یکجا"
			android:textSize="14sp"
			android:textColor="#006020" />
		<LinearLayout
			android:id="@+id/linear8"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingLeft="22dp"
			android:paddingTop="24dp"
			android:paddingRight="22dp"
			android:paddingBottom="24dp"
			android:background="@drawable/bg_glass_card"
			android:orientation="vertical"
			android:elevation="4dp">
			<TextView
				android:id="@+id/textview9"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="10dp"
				android:text="توکن ربات"
				android:textSize="13sp"
				android:textStyle="bold"
				android:textColor="#00922C" />
			<EditText
				android:id="@+id/edtToken"
				android:layout_width="match_parent"
				android:layout_height="52dp"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"
				android:background="@drawable/bg_token_field"
				android:gravity="center_vertical"
				android:textSize="14sp"
				android:textColor="#1A1A1A"
				android:hint="Token"
				android:textColorHint="#777777"
				android:singleLine="true"
				android:imeOptions="actionDone"
				android:inputType="textNoSuggestions" />
			<Button
				android:id="@+id/btnLogin"
				android:layout_width="match_parent"
				android:layout_height="52dp"
				android:layout_marginTop="16dp"
				android:background="@drawable/btn_login"
				android:text="ورود به ربات"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF" />
		</LinearLayout>
		<TextView
			android:id="@+id/textview10"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="48dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="BaLeX v1.0 — Unofficial Bot Manager"
			android:textSize="11sp"
			android:textColor="#007020" />
	</LinearLayout>
</ScrollView>
